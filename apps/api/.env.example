# Copy to apps/api/.env and adjust. Relative paths are resolved against the repository root.
# Environment variables take precedence over this file.

# Which trained model the API uses (default: ml/checkpoints/guitar/best.pt)
MODEL_CHECKPOINT=ml/checkpoints/guitar_v10/best.pt
# Optional: a model with a tab head (ml/configs/guitar_tab.yaml) that places notes on
# strings/frets; notes still come from MODEL_CHECKPOINT.
MODEL_TAB_CHECKPOINT=ml/checkpoints/guitar_v7/best.pt
# MODEL_DEVICE=cuda

# Database and uploaded audio (defaults: apps/api/transcriber.db, apps/api/storage)
# DATABASE_URL=sqlite:///apps/api/transcriber.db
# STORAGE_DIR=apps/api/storage

# Jobs: in-process (no Redis) or Celery
USE_CELERY=false
# REDIS_URL=redis://localhost:6379/0

# Limits
# MAX_UPLOAD_MB=50
# MAX_AUDIO_MINUTES=20
# MAX_NOTES=20000
# JOB_TIMEOUT_MINUTES=60

# Web app origin(s) allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000
# EXPOSE_DOCS=true
