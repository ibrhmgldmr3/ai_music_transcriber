{"nodes": [{"id": "readme_music_transcriber", "label": "Music Transcriber (end-to-end guitar AMT project)", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_amt_model", "label": "AMT model: CNN -> BiLSTM -> onset/frame/offset heads", "file_type": "concept", "source_file": "README.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tab_optimizer", "label": "Tab optimizer (Viterbi minimum-cost fingering path)", "file_type": "rationale", "source_file": "README.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core design decision: the ML model detects notes, an algorithmic cost-based system (packages/music-core/tab.py) picks string/fret. Cost = hand position vs preferred fret + open strings + chord span + stretch, plus position/string changes between events. Weights grid-searched on GuitarSet val (scripts/tune_tab.py); string/fret accuracy 0.575 -> 0.717."}, {"id": "readme_tab_head", "label": "Tab head model (learns string/fret directly)", "file_type": "concept", "source_file": "README.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Very good at position choice but its shared layers drift from pitch detection, so it is used as a second model rather than the only one."}, {"id": "readme_two_model_pairing", "label": "Notes model + tab model pairing (-log p term in optimizer cost)", "file_type": "rationale", "source_file": "README.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Notes from MODEL_CHECKPOINT, string/fret probabilities from MODEL_TAB_CHECKPOINT; model guides, optimizer keeps chords playable and hand movement low. Best result: note F1 0.900, string/fret 0.95, fully correct 0.81."}, {"id": "readme_guitarset", "label": "GuitarSet dataset", "file_type": "concept", "source_file": "README.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_player_based_split", "label": "Player-based split (train 00-03, val 04, test 05)", "file_type": "rationale", "source_file": "README.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split by player rather than random frames so the model is tested against a guitarist never seen in training; no augmentation on val/test."}, {"id": "readme_offline_augmentation", "label": "Offline augmentation (pitch shift, tempo, noise, reverb, overdrive, distortion, echo, phone, room)", "file_type": "concept", "source_file": "README.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_egdb", "label": "EGDB electric guitar dataset", "file_type": "concept", "source_file": "README.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Labels carry quantized tablature timing, so EGDB originally only trained the tab model; RealData clips excluded (model outputs, not references)."}, {"id": "readme_guitar_techs", "label": "Guitar-TECHS dataset", "file_type": "concept", "source_file": "README.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MIDI offset up to 65 ms vs DI; labels aligned to DI onset envelope then cross-correlated per recording."}, {"id": "readme_egdb_alignment", "label": "EGDB label alignment to V9 onsets (scripts/align_egdb.py)", "file_type": "rationale", "source_file": "README.md", "source_location": "L167", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each label moved to V9's onset on same pitch within +/-60 ms (80% moved, median 13 ms); 9 mismatched clips dropped. CQT energy-rise alignment was tried first and failed (labels shifted ~15 ms early for bass notes)."}, {"id": "readme_simulated_rooms", "label": "Simulated rooms and codecs augmentation (pyroomacoustics, Opus/AAC/MP3)", "file_type": "concept", "source_file": "README.md", "source_location": "L166", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alone (V10a) it did not help real room recordings: acoustic guitar in a room does not resemble an electric amp in a room."}, {"id": "readme_v7_tab_model", "label": "V7 tab model (GuitarSet + EGDB + Guitar-TECHS)", "file_type": "concept", "source_file": "README.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_v8_model", "label": "V8 notes model (GuitarSet + Guitar-TECHS)", "file_type": "concept", "source_file": "README.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_v9_model", "label": "V9 notes model (range extended down to C2)", "file_type": "concept", "source_file": "README.md", "source_location": "L559", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_v10_model", "label": "V10 notes model (default; rooms + aligned EGDB)", "file_type": "concept", "source_file": "README.md", "source_location": "L162", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as default because its 2-3 point gain on real room-mic recordings (Guitar-TECHS) outweighs a 0.3-0.6 point loss on simulated conditions."}, {"id": "readme_voice_mode", "label": "Voice -> guitar mode (sing/hum/whistle to TAB, ml/inference/voice.py)", "file_type": "concept", "source_file": "README.md", "source_location": "L309", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No trained model: pitch tracking, personal tuning offset, segmentation on 200 ms context pitch change >= 0.7 semitone, octave transposition to guitar range."}, {"id": "readme_pyin", "label": "pYIN pitch tracker (librosa)", "file_type": "concept", "source_file": "README.md", "source_location": "L313", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept over CREPE (0.63) and PESTO (0.64): pYIN 0.67 note F1; CREPE only better on layered/effected vocals, not worth an 89 MB model."}, {"id": "readme_crepe", "label": "CREPE (torchcrepe) pitch tracker", "file_type": "concept", "source_file": "README.md", "source_location": "L344", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_pesto", "label": "PESTO pitch tracker", "file_type": "concept", "source_file": "README.md", "source_location": "L344", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_vocalset", "label": "VocalSet + Annotated-VocalSet datasets", "file_type": "concept", "source_file": "README.md", "source_location": "L328", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_song_mode", "label": "Song -> guitar mode (chords + melody, ml/inference/song.py)", "file_type": "concept", "source_file": "README.md", "source_location": "L353", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_demucs", "label": "Demucs htdemucs_6s source separation", "file_type": "concept", "source_file": "README.md", "source_location": "L357", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Off by default for guitar projects because it increases processing time; band recordings improve note F1 0.523 -> 0.847."}, {"id": "readme_beat_this", "label": "Beat This! beat/downbeat tracker (Foscarin et al., ISMIR 2024)", "file_type": "paper", "source_file": "README.md", "source_location": "L358", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_btc_chord_recognizer", "label": "BTC Transformer chord recognizer (Park et al., ISMIR 2019; ml/models/btc.py)", "file_type": "paper", "source_file": "README.md", "source_location": "L359", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inference-only rewrite; weights loaded after SHA-256 check. Beat-synchronous Viterbi with change penalty 1 removes one-beat jumps."}, {"id": "readme_slash_chords", "label": "Slash chord detection (lowest bass note per beat, E1-A3)", "file_type": "rationale", "source_file": "README.md", "source_location": "L360", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strict rule (>=2 beats, bass >=80% energy, peak on pitch axis, tuning offset) because the loose first version dropped AAM 0.928 -> 0.862; benefit unmeasurable, only shown not to harm."}, {"id": "readme_key_segmentation", "label": "Key and key-change segmentation (segment_keys, Viterbi over 24 profiles)", "file_type": "rationale", "source_file": "README.md", "source_location": "L362", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Penalty 2 chosen over 1: penalty 1 is best on AAM but adds false modulations to 15% of single-key recordings."}, {"id": "readme_capo_suggestion", "label": "Capo suggestion (min duration-weighted chord-shape difficulty, capo 0-7)", "file_type": "concept", "source_file": "README.md", "source_location": "L364", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_chord_voicing_search", "label": "Chord shape/voicing search on strings (four-fret window)", "file_type": "concept", "source_file": "README.md", "source_location": "L366", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_aam", "label": "AAM dataset (Ostermann et al., 2023)", "file_type": "concept", "source_file": "README.md", "source_location": "L378", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_mir_eval", "label": "mir_eval metrics", "file_type": "concept", "source_file": "README.md", "source_location": "L228", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_music_analysis", "label": "Key, meter and chord analysis (packages/music-core/analysis.py)", "file_type": "concept", "source_file": "README.md", "source_location": "L437", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-run on note edits without re-running the model; tempo refined to note periodicity because 1% tempo error shifts grid one beat per 100 beats."}, {"id": "readme_tkp_key_profiles", "label": "Temperley-Kostka-Payne major/minor key profiles", "file_type": "concept", "source_file": "README.md", "source_location": "L442", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_beat_tracking_grid", "label": "Tracked beat grid for non-metronome recordings", "file_type": "rationale", "source_file": "README.md", "source_location": "L457", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single tempo drifts on rubato recordings; grid follows Beat This! beats (comp beat F 0.634 -> 0.984). Grid toggle allows reverting since Beat This! sometimes picks wrong metrical level."}, {"id": "readme_btc_notes_chord_fusion", "label": "Chord fusion: BTC log-prob + 4 x note chroma cosine, Viterbi", "file_type": "rationale", "source_file": "README.md", "source_location": "L476", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-6 BTC chords per beat stored at transcription so edits update chords while the recording still votes; weight 4 selected on players 00-03."}, {"id": "readme_rhythm_pattern", "label": "Strum rhythm pattern (packages/music-core/rhythm.py, pendulum rule)", "file_type": "rationale", "source_file": "README.md", "source_location": "L489", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strums from transcription (>=2 notes within 60 ms) since direct audio onsets were too noisy; directions suggested by pendulum rule (78% correct), not heard."}, {"id": "readme_playing_techniques", "label": "Playing techniques: bend, vibrato, slide (ml/inference/techniques.py)", "file_type": "rationale", "source_file": "README.md", "source_location": "L509", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rule-based on per-note pitch contour, thresholds tuned on IDMT AR/FS and tested on LP. Hammer-on/pull-off not detected: attack signature indistinguishable from picked notes in GuitarSet and IDMT has no labels, so editor-only."}, {"id": "readme_pitch_contour_viterbi", "label": "Per-note pitch contour (6-harmonic salience, linear-cost Viterbi)", "file_type": "concept", "source_file": "README.md", "source_location": "L513", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Linear jump cost on purpose: quadratic cost split jumps into small steps producing bend-like ramps."}, {"id": "readme_idmt_smt_guitar", "label": "IDMT-SMT-Guitar dataset (Kehling et al., 2014)", "file_type": "concept", "source_file": "README.md", "source_location": "L511", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tunings_and_capo", "label": "Alternative tunings and capo support", "file_type": "concept", "source_file": "README.md", "source_location": "L553", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tab_head_tuning_remap", "label": "Tab head remap to standard-tuning classes for other tunings", "file_type": "rationale", "source_file": "README.md", "source_location": "L557", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tab model trained only on standard tuning recognizes strings by pitches heard; asking which standard-tuning class a pitch would fall in raised one-step-down accuracy 65% -> 93%."}, {"id": "readme_midi_export", "label": "MIDI export (tempo map, per-string channels, pitch bend)", "file_type": "concept", "source_file": "README.md", "source_location": "L580", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pitch bend affects whole channel, so technique files put each string on its own channel (Guitar Pro 'MIDI guitar' layout)."}, {"id": "readme_musicxml_export", "label": "MusicXML 4.0 export (notation + TAB staves, chord symbols)", "file_type": "concept", "source_file": "README.md", "source_location": "L581", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ascii_tab_export", "label": "ASCII TAB export", "file_type": "concept", "source_file": "README.md", "source_location": "L582", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_music_editor", "label": "Web music editor (waveform, TAB, piano roll, loop, metronome, drag editing, undo)", "file_type": "concept", "source_file": "README.md", "source_location": "L276", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_karplus_strong_synth", "label": "Karplus-Strong string synthesis in browser", "file_type": "concept", "source_file": "README.md", "source_location": "L278", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_opensheetmusicdisplay", "label": "OpenSheetMusicDisplay score rendering", "file_type": "concept", "source_file": "README.md", "source_location": "L283", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_api_service", "label": "API service (FastAPI + SQLAlchemy + Celery, apps/api)", "file_type": "concept", "source_file": "README.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_api_endpoints", "label": "REST API endpoints (/api/projects, /api/analysis, /api/chords/voicings, /api/render/musicxml, /api/models)", "file_type": "concept", "source_file": "README.md", "source_location": "L636", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_security_model", "label": "Security model (no auth, localhost binding, upload magic-bytes, CSRF origin check, CSP)", "file_type": "rationale", "source_file": "README.md", "source_location": "L621", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-user local design: Docker Compose binds ports only to 127.0.0.1; remote access requires an authenticating reverse proxy."}, {"id": "readme_docker_deployment", "label": "Docker Compose deployment (CPU / NVIDIA GPU)", "file_type": "concept", "source_file": "README.md", "source_location": "L240", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shared_web_fixture", "label": "Shared Python/TypeScript fixture (tests/fixtures/music_web.json)", "file_type": "rationale", "source_file": "README.md", "source_location": "L667", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web app re-implements note naming, bar numbering, TAB labels and technique shapes in TypeScript; a Python-generated fixture tested on both sides prevents divergence from music_core."}, {"id": "readme_ci_workflow", "label": "GitHub Actions CI (ruff, pytest, tsc, Vitest, Next.js build)", "file_type": "concept", "source_file": "README.md", "source_location": "L673", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_musdb18", "label": "MUSDB18 stems (band-mix evaluation)", "file_type": "concept", "source_file": "README